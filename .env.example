# Valores solo para desarrollo local. Usa secretos fuertes en producción.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=burgos_app
MYSQL_PASSWORD=local_app_password
MYSQL_DATABASE=burgos_peluqueria
MYSQL_SSL=false

# Docker Compose values live in .env.docker.example; keep the root password
# out of the Next.js process environment.
MYSQL_ROOT_PASSWORD=local_root_password
